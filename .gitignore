# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# macOS
.DS_Store

# dependencies
/node_modules

# next.js
/.next/
/out/

# production
/build

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files
.env*

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# NDA-sensitive project data (keep local only)
src/data/projects.json

# temporary screenshots
*.png
!public/**/*.png
!docs/**/*.png

# playwright
.playwright-mcp/

# font previews
font-previews/

# Generated application PDFs. This repo is PUBLIC and Next.js serves public/
# at the site root, so committing these would publish them to the world —
# the deck's figures still contain internal Japanese project terminology.
# Backed up to the private iori73/portfolio-assets repo instead.
#
# The résumé is the exception and IS committed: it is text only, rendered from
# the same cvData already published at /cv, with clients behind industry labels
# and the generator's client-name denylist asserted on every build. It has to be
# in the repo for the Download button on /cv to resolve.
public/downloads/*
!public/downloads/Iori-Kawano-Resume-*.pdf
# Claude Code の個人用オーバーライド（マシン固有・共有しない）
.claude/settings.local.json
