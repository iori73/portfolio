# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# macOS
.DS_Store

# dependencies
/node_modules

# next.js
/.next/
/out/

# production
/build

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files
.env*

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# NDA-sensitive project data (keep local only)
src/data/projects.json

# temporary screenshots
*.png
!public/**/*.png
!docs/**/*.png

# playwright
.playwright-mcp/

# font previews
font-previews/

# Generated application PDFs. This repo is PUBLIC and Next.js serves public/
# at the site root, so committing these would publish them to the world —
# the figures still contain internal Japanese project terminology.
# Backed up to the private iori73/portfolio-assets repo instead.
public/downloads/